extends SceneTree


func _initialize() -> void:
	assert(TrapCatalog.has("door_crossbow"))
	var trap: TrapDefinition = TrapCatalog.get_trap("door_crossbow")
	assert(trap != null)
	assert(trap.can_attach_to("door"))
	assert(not trap.can_attach_to("floor"))
	assert(trap.direct_damage == 4)
	assert(trap.disarm_on_trigger)
	assert(trap.hidden_by_default)
	assert(not trap.trigger_message.is_empty())
	assert(trap.icon != null)
	assert("door_crossbow" in TrapCatalog.list_ids("door"))
	assert("door_crossbow" not in TrapCatalog.list_ids("floor"))
	assert("spikes" in TrapCatalog.list_ids("floor"))

	var map: DungeonMap = DungeonMap.create_blank(6, 6)
	assert(map.place_entity("door", 2, 2))
	assert(not map.place_entity("trap", 3, 2, {"trap_id": "door_crossbow"}))
	var door: Dictionary = map.entities_at(2, 2)[0]
	var door_id: String = str(door["id"])
	assert(DungeonMap.door_trap_id(door).is_empty())
	assert(map.attach_door_trap(door_id, "door_crossbow"))
	assert(not map.attach_door_trap(door_id, "door_crossbow"))
	assert(not map.attach_door_trap(door_id, "spikes"))
	assert(DungeonMap.door_trap_id(door) == trap.trap_id)
	assert(DungeonMap.door_trap_message(door) == trap.trigger_message)
	assert(TrapCatalog.from_door(door) == trap)
	assert(map.set_door_trap_message(door_id, "Осторожно, болт!"))
	assert(DungeonMap.door_trap_message(door) == "Осторожно, болт!")
	assert(not map.set_door_trap_message(door_id, "Осторожно, болт!"))
	assert(map.set_door_trap_message(door_id, ""))
	assert(DungeonMap.door_trap_message(door) == trap.trigger_message)
	assert(map.set_message_at(2, 2, "Скрип двери"))
	assert(map.move_existing("door", door_id, Vector2i(2, 2), Vector2i(3, 2)))
	assert(DungeonMap.door_trap_id(map.entities_at(3, 2)[0]) == trap.trap_id)
	assert(str(map.message_at(3, 2).get("properties", {}).get("text", "")) == "Скрип двери")
	assert(map.place_entity("door", 4, 2))
	var second_door: Dictionary = map.entities_at(4, 2)[0]
	var second_id: String = str(second_door["id"])
	assert(map.attach_door_trap(second_id, trap.trap_id))
	assert(map.set_door_trap_message(second_id, "Своя надпись"))

	var saved: String = JSON.stringify(map.to_dict())
	var restored: DungeonMap = DungeonMap.from_dict(JSON.parse_string(saved))
	assert(restored != null)
	assert(JSON.stringify(restored.to_dict()) == saved)
	var restored_door: Dictionary = restored.entities_at(3, 2)[0]
	assert(DungeonMap.door_trap_id(restored_door) == trap.trap_id)
	assert(DungeonMap.door_trap_message(restored_door) == trap.trigger_message)
	assert(DungeonMap.door_trap_message(restored.entities_at(4, 2)[0]) == "Своя надпись")
	assert(restored.set_door_lock(door_id, "key_red"))
	assert(DungeonMap.door_trap_id(restored_door) == trap.trap_id)
	assert(restored.remove_door_trap(door_id))
	assert(not restored.remove_door_trap(door_id))
	assert(DungeonMap.door_trap_id(restored_door).is_empty())

	var legacy: DungeonMap = DungeonMap.create_blank(6, 6)
	assert(legacy.place_entity("door", 3, 3))
	var loaded: DungeonMap = DungeonMap.from_dict(JSON.parse_string(JSON.stringify(legacy.to_dict())))
	assert(loaded != null)
	assert(DungeonMap.door_trap_id(loaded.entities_at(3, 3)[0]).is_empty())
	assert(loaded.place_entity("trap", 2, 2, {"trap_id": "spikes"}))
	assert(DungeonMap.trap_id(loaded.entities_at(2, 2)[0]) == "spikes")

	print("Door trap data tests passed")
	quit()
