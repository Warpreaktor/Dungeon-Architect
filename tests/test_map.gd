extends SceneTree

## Минимальный smoke-test модели. Запускается через Godot --headless --script.
func _initialize() -> void:
	var model := DungeonMap.create_blank(12, 12)
	assert(model.get_terrain(0, 0) == "wall")
	assert(model.get_terrain(1, 1) == "floor")
	assert(model.place_entity("chest", 3, 3))
	assert(model.place_entity("trigger", 3, 3))
	assert(model.entities_at(3, 3).size() == 2)
	assert(model.place_entity("player_spawn", 2, 2))
	assert(model.place_entity("player_spawn", 4, 4))
	var hero_count := 0
	for entity in model.entities:
		if entity["type"] == "player_spawn":
			hero_count += 1
	assert(hero_count == 1)
	var text_json := JSON.stringify(model.to_dict())
	var restored := DungeonMap.from_dict(JSON.parse_string(text_json))
	assert(restored != null)
	assert(restored.width == 12)
	assert(restored.entities_at(3, 3).size() == 2)
	assert(restored.erase_at(3, 3))
	assert(restored.entities_at(3, 3).size() == 1)
	# Минимальная карта тоже должна быть редактируемой и сохраняемой.
	var tiny := DungeonMap.create_blank(1, 1)
	assert(tiny.width == 1 and tiny.height == 1)
	assert(tiny.get_terrain(0, 0) == "floor")
	assert(tiny.place_entity("player_spawn", 0, 0))
	var tiny_restored := DungeonMap.from_dict(JSON.parse_string(JSON.stringify(tiny.to_dict())))
	assert(tiny_restored != null)
	assert(tiny_restored.width == 1 and tiny_restored.height == 1)
	var tiny_session := GameSession.start_for(tiny_restored)
	assert(tiny_session != null)
	assert(not tiny_session.move_by(1, 0))

	# Прямоугольные размеры и границы.
	var rectangular := DungeonMap.create_blank(16, 48)
	assert(rectangular.width == 16 and rectangular.height == 48)
	assert(rectangular.get_terrain(0, 0) == "wall")
	assert(rectangular.get_terrain(1, 1) == "floor")
	assert(DungeonMap.from_dict(JSON.parse_string(JSON.stringify(rectangular.to_dict()))) != null)

	# Новый сундук пуст, содержимое настраивается после размещения.
	var loot_map := DungeonMap.create_blank(8, 8)
	assert(loot_map.place_entity("player_spawn", 2, 2))
	assert(loot_map.place_entity("chest", 3, 2))
	assert(loot_map.place_entity("chest", 2, 3))
	assert(loot_map.place_entity("door", 4, 2))
	var empty_chest: Dictionary = loot_map.entities_at(3, 2)[0]
	var packed_chest: Dictionary = loot_map.entities_at(2, 3)[0]
	assert(DungeonMap.chest_contents(empty_chest).is_empty())
	var packed_id: String = str(packed_chest["id"])
	assert(loot_map.set_chest_contents(packed_id, ["key", "potion"]))
	assert(not loot_map.set_chest_contents(packed_id, ["key", "potion"]))
	assert(DungeonMap.chest_contents(packed_chest) == ["key", "potion"])
	var saved_json := JSON.stringify(loot_map.to_dict())
	var loot_session := GameSession.start_for(loot_map)
	assert(loot_session.move_by(1, 0)) # Пустой сундук не блокирует проход.
	assert(loot_session.keys == 0 and loot_session.potions == 0)
	assert(not loot_session.move_by(1, 0)) # Дверь без ключа закрыта.
	assert(loot_session.move_by(-1, 0))
	assert(not loot_session.move_by(0, 1)) # Сундук с добычей открывается за один шаг.
	assert(loot_session.keys == 1 and loot_session.potions == 1)
	assert(loot_session.is_chest_open(packed_chest))
	assert(loot_session.move_by(0, 1))
	assert(loot_session.keys == 1 and loot_session.potions == 1)
	assert(loot_session.move_by(1, 0) and loot_session.move_by(1, 0))
	assert(loot_session.move_by(0, -1)) # Ключ открывает дверь и расходуется.
	assert(loot_session.keys == 0)
	assert(JSON.stringify(loot_map.to_dict()) == saved_json)
	var another_session := GameSession.start_for(loot_map)
	assert(not another_session.is_chest_open(packed_chest))

	# Выбор вида монстра в палитре сразу задаёт свойства созданной сущности.
	var monster_palette_map := DungeonMap.create_blank(8, 8)
	assert(monster_palette_map.place_entity("monster", 2, 2, {"monster_id": "rabbit_symbiont"}))
	assert(monster_palette_map.place_entity("monster", 3, 2, {"monster_id": "hunter"}))
	assert(MonsterCatalog.from_entity(monster_palette_map.entities_at(2, 2)[0]).max_health == 3)
	assert(MonsterCatalog.from_entity(monster_palette_map.entities_at(3, 2)[0]).max_health == 5)
	assert(MonsterCatalog.from_entity(monster_palette_map.entities_at(3, 2)[0]).attack_damage == 2)
	assert(not monster_palette_map.place_entity("monster", 3, 2, {"monster_id": "rabbit_symbiont"}))
	var monster_palette_restored := DungeonMap.from_dict(JSON.parse_string(JSON.stringify(monster_palette_map.to_dict())))
	assert(monster_palette_restored != null)
	assert(MonsterCatalog.from_entity(monster_palette_restored.entities_at(3, 2)[0]).monster_id == "hunter")
	assert(monster_palette_map.place_entity("monster", 4, 2)) # Старые карты и вызовы без options.
	assert(MonsterCatalog.from_entity(monster_palette_map.entities_at(4, 2)[0]).monster_id == MonsterCatalog.DEFAULT_MONSTER_ID)

	# Ручное управление экипировкой через GameSession; бонусы берутся из .tres.
	var equip_map := DungeonMap.create_blank(8, 8)
	assert(equip_map.place_entity("player_spawn", 2, 2))
	assert(equip_map.place_entity("chest", 3, 2))
	var equipment_chest: Dictionary = equip_map.entities_at(3, 2)[0]
	assert(equip_map.set_chest_contents(str(equipment_chest["id"]), ["sword", "shield"]))
	var equipment_map_json: String = JSON.stringify(equip_map.to_dict())
	var equipment_session := GameSession.start_for(equip_map)
	assert(not equipment_session.move_by(1, 0))
	assert(equipment_session.hero.equipped_weapon_id == "sword")
	assert(equipment_session.hero.equipped_shield_id == "shield")
	assert(equipment_session.carried_items["sword"] == 1)
	assert(equipment_session.carried_items["shield"] == 1)
	var sword_def: ItemDefinition = ItemCatalog.get_item("sword")
	var shield_def: ItemDefinition = ItemCatalog.get_item("shield")
	assert(equipment_session.hero.attack == HeroState.START_ATTACK + sword_def.attack_bonus + shield_def.attack_bonus)
	assert(equipment_session.hero.defense == HeroState.START_DEFENSE + sword_def.defense_bonus + shield_def.defense_bonus)
	assert(equipment_session.unequip_item("sword"))
	assert(equipment_session.hero.equipped_weapon_id.is_empty())
	assert(equipment_session.hero.attack == HeroState.START_ATTACK + shield_def.attack_bonus)
	assert(equipment_session.carried_items["sword"] == 1) # Предмет не расходуется.
	assert(not equipment_session.unequip_item("sword"))
	assert(equipment_session.equip_item("sword"))
	assert(not equipment_session.equip_item("sword"))
	assert(not equipment_session.equip_item("potion"))
	assert(not equipment_session.equip_item("gold"))
	assert(not equipment_session.equip_item("unknown"))
	assert(equipment_session.unequip_item("shield"))
	assert(equipment_session.hero.defense == HeroState.START_DEFENSE + sword_def.defense_bonus)
	assert(equipment_session.equip_item("shield"))
	assert(equipment_session.hero.take_damage(2) == maxi(2 - equipment_session.hero.defense, 0))
	assert(JSON.stringify(equip_map.to_dict()) == equipment_map_json)
	var equipment_restart: GameSession = GameSession.start_for(equip_map)
	assert(equipment_restart.hero.equipped_weapon_id.is_empty())
	assert(equipment_restart.hero.equipped_shield_id.is_empty())

	# Контакт с монстром создаёт встречу, но карта остаётся неизменной.
	var encounter_map := DungeonMap.create_blank(8, 8)
	assert(encounter_map.place_entity("player_spawn", 2, 2))
	assert(encounter_map.place_entity("monster", 3, 2))
	assert(encounter_map.place_entity("key", 3, 2))
	var monster: Dictionary = encounter_map.entities_at(3, 2)[0]
	var encounter_map_before := JSON.stringify(encounter_map.to_dict())
	var encounter := GameSession.start_for(encounter_map)
	assert(encounter != null)
	assert(not encounter.move_by(1, 0))
	assert(encounter.has_pending_encounter())
	assert(encounter.encounter_target == Vector2i(3, 2))
	assert(encounter.player_pos == Vector2i(2, 2))
	assert(encounter.steps == 0)
	assert(encounter.keys == 0)
	assert(not encounter.is_entity_removed(monster))
	assert(not encounter.move_by(0, 1)) # Во время боя нельзя ходить.

	var combat := CombatSession.new()
	assert(combat.enemy_health == 3)
	assert(combat.hero_punch() == 1)
	assert(not combat.is_victory)
	assert(combat.hero_punch() == 1)
	assert(combat.hero_punch() == 1 and combat.is_victory)
	assert(combat.enemy_health == 0)
	assert(combat.hero_punch() == 0) # Победа выдаётся только однажды.
	assert(encounter.win_pending_encounter())
	assert(not encounter.has_pending_encounter())
	assert(encounter.is_entity_removed(monster))
	assert(encounter.player_pos == Vector2i(3, 2))
	assert(encounter.steps == 1)
	assert(encounter.keys == 1) # Можно собрать находку под монстром.
	assert(JSON.stringify(encounter_map.to_dict()) == encounter_map_before)
	assert(not encounter.win_pending_encounter())
	var encounter_again := GameSession.start_for(encounter_map)
	assert(not encounter_again.move_by(1, 0)) # Новый тест снова начинает бой.
	assert(encounter_again.has_pending_encounter())

	# Победа не позволяет пройти сквозь всё остальное: запертая дверь остаётся.
	var guarded_door := DungeonMap.create_blank(8, 8)
	assert(guarded_door.place_entity("player_spawn", 2, 2))
	assert(guarded_door.place_entity("monster", 3, 2))
	assert(guarded_door.place_entity("door", 3, 2))
	var guarded := GameSession.start_for(guarded_door)
	assert(not guarded.move_by(1, 0))
	assert(not guarded.win_pending_encounter())
	assert(guarded.player_pos == Vector2i(2, 2))
	assert(not guarded.has_pending_encounter())
	assert(guarded.last_event_message == "Дверь заперта. Нужен ключ.")
	assert(guarded.move_by(0, 1))

	# Лестница пока завершает тестовую сессию, не меняя карту редактора.
	var finish_map := DungeonMap.create_blank(8, 8)
	assert(finish_map.place_entity("player_spawn", 2, 2))
	assert(finish_map.place_entity("stairs_down", 3, 2))
	var before_finish := JSON.stringify(finish_map.to_dict())
	var finish_session := GameSession.start_for(finish_map)
	assert(not finish_session.is_completed)
	assert(finish_session.move_by(1, 0))
	assert(finish_session.is_completed)
	assert(finish_session.player_pos == Vector2i(3, 2))
	assert(finish_session.steps == 1)
	assert(not finish_session.move_by(0, 1)) # После завершения ходить нельзя.
	assert(JSON.stringify(finish_map.to_dict()) == before_finish)
	var finish_again := GameSession.start_for(finish_map)
	assert(not finish_again.is_completed)
	assert(finish_again.move_by(1, 0)) # Новая попытка снова может закончиться победой.

	# Лестница под монстром срабатывает только после победы в бою.
	var guarded_exit := DungeonMap.create_blank(8, 8)
	assert(guarded_exit.place_entity("player_spawn", 2, 2))
	assert(guarded_exit.place_entity("monster", 3, 2))
	assert(guarded_exit.place_entity("stairs_down", 3, 2))
	var guarded_exit_session := GameSession.start_for(guarded_exit)
	assert(not guarded_exit_session.move_by(1, 0))
	assert(not guarded_exit_session.is_completed)
	assert(guarded_exit_session.has_pending_encounter())
	assert(guarded_exit_session.win_pending_encounter())
	assert(guarded_exit_session.is_completed)

	# Невидимые триггеры срабатывают один раз за прохождение, в том числе при старте.
	var trigger_map := DungeonMap.create_blank(8, 8)
	assert(trigger_map.place_entity("player_spawn", 2, 2))
	assert(trigger_map.place_entity("trigger", 2, 2))
	assert(trigger_map.place_entity("trigger", 3, 2))
	assert(trigger_map.place_entity("trigger", 3, 3))
	var custom_trigger: Dictionary = trigger_map.entities_at(3, 2)[0]
	var trigger_id := str(custom_trigger["id"])
	assert(trigger_map.set_trigger_event_id(trigger_id, "  secret_passage  "))
	assert(not trigger_map.set_trigger_event_id(trigger_id, "secret_passage"))
	assert(str(custom_trigger["properties"]["event_id"]) == "secret_passage")
	var trigger_json := JSON.stringify(trigger_map.to_dict())
	var trigger_restored := DungeonMap.from_dict(JSON.parse_string(trigger_json))
	assert(trigger_restored != null)
	var trigger_session := GameSession.start_for(trigger_restored)
	assert(trigger_session != null)
	var first_events := trigger_session.take_trigger_events()
	assert(first_events.size() == 1)
	assert(first_events[0]["position"] == Vector2i(2, 2))
	assert(str(first_events[0]["event_id"]) == "")
	assert(trigger_session.take_trigger_events().is_empty())
	assert(trigger_session.move_by(1, 0))
	var events := trigger_session.take_trigger_events()
	assert(events.size() == 1)
	assert(str(events[0]["entity_id"]) == trigger_id)
	assert(str(events[0]["event_id"]) == "secret_passage")
	assert(trigger_session.move_by(0, 1))
	events = trigger_session.take_trigger_events()
	assert(events.size() == 1 and str(events[0]["event_id"]) == "")
	assert(trigger_session.move_by(0, -1))
	assert(trigger_session.take_trigger_events().is_empty()) # Повторный вход в ту же клетку.
	assert(trigger_session.move_by(-1, 0))
	assert(trigger_session.take_trigger_events().is_empty()) # Стартовый триггер тоже одноразовый.
	assert(JSON.stringify(trigger_restored.to_dict()) == trigger_json)
	var trigger_again := GameSession.start_for(trigger_restored)
	assert(trigger_again.take_trigger_events().size() == 1) # Новый тест сбрасывает активации.
	assert(trigger_again.move_by(1, 0))
	assert(trigger_again.take_trigger_events().size() == 1)

	# Авторские сообщения: вход на клетку, старт и привязка к двери.
	var story_map := DungeonMap.create_blank(8, 8)
	assert(story_map.place_entity("player_spawn", 2, 2))
	assert(story_map.set_message_at(2, 2, "  Начало пути  "))
	assert(story_map.set_message_at(3, 2, "Берегись темноты!"))
	assert(story_map.place_entity("door", 4, 2))
	assert(story_map.set_message_at(4, 2, "Ты пробудил древнее проклятие."))
	assert(story_map.place_entity("key", 2, 3))
	var door_message := story_map.message_at(4, 2)
	assert(door_message["properties"]["activation"] == "door_open")
	var saved_story := JSON.stringify(story_map.to_dict())
	var story_restored := DungeonMap.from_dict(JSON.parse_string(saved_story))
	assert(story_restored != null)
	var story := GameSession.start_for(story_restored)
	var read := story.take_message_events()
	assert(read.size() == 1 and read[0]["text"] == "Начало пути")
	assert(story.take_message_events().is_empty())
	assert(story.move_by(1, 0))
	read = story.take_message_events()
	assert(read.size() == 1 and read[0]["text"] == "Берегись темноты!")
	assert(not story.move_by(1, 0)) # Дверь заперта, преждевременного сообщения нет.
	assert(story.take_message_events().is_empty())
	assert(story.move_by(-1, 0) and story.move_by(0, 1)) # Подбираем ключ.
	assert(story.move_by(1, 0) and story.move_by(1, 0))
	assert(story.move_by(0, -1)) # Дверь открывается только после подбора ключа.
	assert(story.keys == 0)
	read = story.take_message_events()
	assert(read.size() == 1 and read[0]["text"] == "Ты пробудил древнее проклятие.")
	assert(story.move_by(-1, 0) and story.move_by(1, 0))
	assert(story.take_message_events().is_empty())
	assert(JSON.stringify(story_restored.to_dict()) == saved_story)
	var story_again := GameSession.start_for(story_restored)
	assert(story_again.take_message_events().size() == 1)
	var message_id := str(story_restored.message_at(3, 2)["id"])
	assert(story_restored.set_message_at(3, 2, "Новая надпись"))
	assert(str(story_restored.message_at(3, 2)["id"]) == message_id)
	assert(not story_restored.set_message_at(3, 2, "Новая надпись"))
	assert(story_restored.set_message_at(3, 2, ""))
	assert(story_restored.message_at(3, 2).is_empty())
	# Перенос двери забирает прикреплённый текст с собой.
	var door_to_move := story_restored.entities_at(4, 2)[0]
	var door_id: String = str(door_to_move["id"])
	assert(story_restored.move_existing("door", door_id, Vector2i(4, 2), Vector2i(4, 3)))
	assert(story_restored.message_at(4, 2).is_empty())
	assert(story_restored.message_at(4, 3)["properties"]["target_entity_id"] == door_id)

	# Существующая карта с полем reward продолжает работать.
	var legacy_map := DungeonMap.from_dict(loot_map.to_dict())
	var legacy_chest: Dictionary = legacy_map.entities_at(3, 2)[0]
	legacy_chest["properties"] = {"reward": "key"}
	assert(DungeonMap.chest_contents(legacy_chest) == ["key"])
	var legacy_session := GameSession.start_for(legacy_map)
	assert(not legacy_session.move_by(1, 0))
	assert(legacy_session.keys == 1)
	assert(legacy_map.set_chest_contents(str(legacy_chest["id"]), []))
	assert(DungeonMap.chest_contents(legacy_chest).is_empty())
	# DA-2.03.1: каталог предметов, монеты и временные изменения только в сессии.
	var gold_item := ItemCatalog.get_item("gold")
	assert(gold_item != null)
	assert(gold_item.category == ItemDefinition.Category.CURRENCY)
	assert(gold_item.default_quantity == 5)
	assert(ItemCatalog.get_item("key") != null)
	assert(ItemCatalog.get_item("potion") != null)
	assert(ItemCatalog.get_item("missing") == null)
	var gold_map := DungeonMap.create_blank(8, 8)
	assert(gold_map.place_entity("player_spawn", 2, 2))
	assert(gold_map.place_entity("gold", 3, 2))
	assert(gold_map.place_entity("gold", 4, 2))
	assert(gold_map.place_entity("key", 4, 2))
	var gold_json := JSON.stringify(gold_map.to_dict())
	var gold_map_loaded := DungeonMap.from_dict(JSON.parse_string(gold_json))
	assert(gold_map_loaded != null)
	var gold_session := GameSession.start_for(gold_map_loaded)
	assert(gold_session.hero.gold == 0)
	assert(gold_session.move_by(1, 0))
	assert(gold_session.hero.gold == 5)
	assert(gold_session.move_by(1, 0))
	assert(gold_session.hero.gold == 10 and gold_session.keys == 1)
	assert(gold_session.carried_items.get("key", 0) == 1)
	assert(JSON.stringify(gold_map_loaded.to_dict()) == gold_json)
	var new_gold_session := GameSession.start_for(gold_map_loaded)
	assert(new_gold_session.hero.gold == 0)
	assert(new_gold_session.move_by(1, 0))
	assert(new_gold_session.hero.gold == 5)
	# Золото в сундуке: 5 монет, вместе с ключом и зельем; без изменений JSON карты.
	var treasure_map := DungeonMap.create_blank(8, 8)
	assert(treasure_map.place_entity("player_spawn", 2, 2))
	assert(treasure_map.place_entity("chest", 3, 2))
	var treasure_chest: Dictionary = treasure_map.entities_at(3, 2)[0]
	var treasure_id: String = str(treasure_chest["id"])
	assert(treasure_map.set_chest_contents(treasure_id, ["key", "potion", "gold"]))
	assert(not treasure_map.set_chest_contents(treasure_id, ["key", "potion", "gold"]))
	assert(DungeonMap.chest_contents(treasure_chest) == ["key", "potion", "gold"])
	var treasure_json := JSON.stringify(treasure_map.to_dict())
	var treasure_restored := DungeonMap.from_dict(JSON.parse_string(treasure_json))
	assert(treasure_restored != null)
	var treasure_session := GameSession.start_for(treasure_restored)
	assert(not treasure_session.move_by(1, 0)) # Открытие сундука занимает ход.
	assert(treasure_session.keys == 1 and treasure_session.potions == 1)
	assert(treasure_session.hero.gold == 5)
	assert(treasure_session.move_by(1, 0)) # Повторно награда не выдаётся.
	assert(treasure_session.hero.gold == 5)
	assert(JSON.stringify(treasure_restored.to_dict()) == treasure_json)
	var treasure_again := GameSession.start_for(treasure_restored)
	assert(treasure_again.hero.gold == 0)
	assert(not treasure_again.move_by(1, 0))
	assert(treasure_again.hero.gold == 5)
	# Сундук с одним золотом также считается заполненным и открывается один раз.
	assert(treasure_map.set_chest_contents(treasure_id, ["gold"]))
	assert(DungeonMap.chest_contents(treasure_chest) == ["gold"])
	var gold_only := GameSession.start_for(treasure_map)
	assert(not gold_only.move_by(1, 0))
	assert(gold_only.hero.gold == 5 and gold_only.keys == 0 and gold_only.potions == 0)
	assert(gold_only.move_by(1, 0) and gold_only.hero.gold == 5)
	# DA-2.03.2: меч только из сундука, сумма золота задана автором.
	var sword_item := ItemCatalog.get_item("sword")
	assert(sword_item != null)
	assert(sword_item.category == ItemDefinition.Category.EQUIPMENT)
	assert(sword_item.attack_bonus == 1)
	var equip_map := DungeonMap.create_blank(8, 8)
	assert(not equip_map.place_entity("sword", 2, 3)) # Меч не размещается на полу карты.
	assert(equip_map.place_entity("player_spawn", 2, 2))
	assert(equip_map.place_entity("chest", 3, 2))
	assert(equip_map.place_entity("monster", 4, 2))
	var equip_chest: Dictionary = equip_map.entities_at(3, 2)[0]
	var equip_chest_id: String = str(equip_chest["id"])
	assert(DungeonMap.chest_gold_amount(equip_chest) == 5) # Старые карты.
	assert(equip_map.set_chest_contents(equip_chest_id, ["sword", "gold"], 37))
	assert(not equip_map.set_chest_contents(equip_chest_id, ["sword", "gold"], 37))
	assert(DungeonMap.chest_gold_amount(equip_chest) == 37)
	var equip_json := JSON.stringify(equip_map.to_dict())
	var equip_loaded := DungeonMap.from_dict(JSON.parse_string(equip_json))
	assert(equip_loaded != null)
	var equip_session := GameSession.start_for(equip_loaded)
	assert(equip_session.hero.attack == 1)
	assert(equip_session.hero.equipped_weapon_id.is_empty())
	assert(not equip_session.move_by(1, 0))
	assert(equip_session.hero.gold == 37)
	assert(equip_session.carried_items.get("sword", 0) == 1)
	assert(equip_session.hero.attack == 2)
	assert(equip_session.hero.equipped_weapon_id == "sword")
	assert(equip_session.move_by(1, 0))
	assert(not equip_session.move_by(1, 0)) # Встречаем монстра.
	assert(equip_session.has_pending_encounter())
	var equip_combat := CombatSession.new()
	assert(equip_combat.hero_attack(equip_session.hero.attack) == 2)
	assert(not equip_combat.is_victory)
	assert(equip_combat.hero_attack(equip_session.hero.attack) == 2 and equip_combat.is_victory)
	assert(equip_session.win_pending_encounter())
	assert(JSON.stringify(equip_loaded.to_dict()) == equip_json)
	var equip_again := GameSession.start_for(equip_loaded)
	assert(equip_again.hero.attack == 1 and equip_again.hero.gold == 0)
	assert(not equip_again.move_by(1, 0))
	assert(equip_again.hero.attack == 2 and equip_again.hero.gold == 37)
	# Сняли золото с сундука: размер денежной награды не влияет на остальные предметы.
	assert(equip_map.set_chest_contents(equip_chest_id, ["sword"]))
	assert(DungeonMap.chest_contents(equip_chest) == ["sword"])
	# DA-2.03.3: послание на монстре показывается перед боем, а не после победы.
	var monster_story_map := DungeonMap.create_blank(8, 8)
	assert(monster_story_map.place_entity("player_spawn", 2, 2))
	assert(monster_story_map.place_entity("monster", 3, 2))
	assert(monster_story_map.set_message_at(3, 2, "Страж проснулся!"))
	assert(monster_story_map.message_at(3, 2)["properties"]["activation"] == "monster_encounter")
	var monster_story_json := JSON.stringify(monster_story_map.to_dict())
	var monster_story_session := GameSession.start_for(monster_story_map)
	assert(not monster_story_session.move_by(1, 0))
	assert(monster_story_session.has_pending_encounter())
	var encounter_dialogue := monster_story_session.take_message_events()
	assert(encounter_dialogue.size() == 1 and encounter_dialogue[0]["text"] == "Страж проснулся!")
	assert(monster_story_session.win_pending_encounter())
	assert(monster_story_session.take_message_events().is_empty())
	assert(JSON.stringify(monster_story_map.to_dict()) == monster_story_json)
	# Старые сообщения типа enter на клетке монстра тоже показываем до боя.
	monster_story_map.message_at(3, 2)["properties"]["activation"] = "enter"
	monster_story_map.message_at(3, 2)["properties"]["target_entity_id"] = ""
	var old_story_session := GameSession.start_for(monster_story_map)
	assert(not old_story_session.move_by(1, 0))
	assert(old_story_session.take_message_events().size() == 1)
	# Послание у монстра можно переносить вместе с ним.
	var story_monster_id := str(monster_story_map.entities_at(3, 2)[0]["id"])
	assert(monster_story_map.move_existing("monster", story_monster_id, Vector2i(3, 2), Vector2i(4, 2)))
	assert(monster_story_map.message_at(3, 2).is_empty())
	assert(not monster_story_map.message_at(4, 2).is_empty())

	# Сундук показывает авторскую реплику и всю добычу в ОДНОМ событии.
	var decorated_chest_map := DungeonMap.create_blank(8, 8)
	assert(decorated_chest_map.place_entity("player_spawn", 2, 2))
	assert(decorated_chest_map.place_entity("chest", 3, 2))
	var decorated_chest: Dictionary = decorated_chest_map.entities_at(3, 2)[0]
	var decorated_chest_id := str(decorated_chest["id"])
	assert(decorated_chest_map.set_chest_contents(decorated_chest_id, ["key", "potion", "gold", "sword", "shield"], 42))
	assert(decorated_chest_map.set_message_at(3, 2, "Найден тайник!"))
	assert(decorated_chest_map.message_at(3, 2)["properties"]["activation"] == "chest_open")
	var decorated_json := JSON.stringify(decorated_chest_map.to_dict())
	var decorated_session := GameSession.start_for(decorated_chest_map)
	assert(not decorated_session.move_by(1, 0))
	var treasure_events := decorated_session.take_message_events()
	assert(treasure_events.size() == 1)
	assert(treasure_events[0]["text"] == "Найден тайник!")
	var treasure_loot: Array = treasure_events[0]["loot"]
	assert(treasure_loot.size() == 5)
	assert(treasure_loot[2]["item_id"] == "gold" and treasure_loot[2]["quantity"] == 42)
	assert(decorated_session.hero.gold == 42)
	assert(decorated_session.hero.attack == 2)
	assert(decorated_session.hero.defense == 1)
	assert(decorated_session.hero.equipped_shield_id == "shield")
	assert(decorated_session.hero.take_damage(2) == 1)
	assert(decorated_session.hero.health == 39)
	assert(decorated_session.move_by(1, 0))
	assert(decorated_session.take_message_events().is_empty())
	assert(JSON.stringify(decorated_chest_map.to_dict()) == decorated_json)
	var decorated_again := GameSession.start_for(decorated_chest_map)
	assert(decorated_again.hero.defense == 0 and decorated_again.hero.gold == 0)
	# Без авторской реплики сундук всё равно показывает найденные предметы.
	assert(decorated_chest_map.set_message_at(3, 2, ""))
	var loot_only_session := GameSession.start_for(decorated_chest_map)
	assert(not loot_only_session.move_by(1, 0))
	var loot_only_events := loot_only_session.take_message_events()
	assert(loot_only_events.size() == 1)
	assert(str(loot_only_events[0]["text"]).is_empty() and loot_only_events[0]["loot"].size() == 5)
	# Новое сообщение движется вместе с сундуком.
	assert(decorated_chest_map.set_message_at(3, 2, "Переносимый текст"))
	assert(decorated_chest_map.move_existing("chest", decorated_chest_id, Vector2i(3, 2), Vector2i(4, 2)))
	assert(decorated_chest_map.message_at(3, 2).is_empty())
	assert(decorated_chest_map.message_at(4, 2)["properties"]["target_entity_id"] == decorated_chest_id)

	# Пять видов врагов с собственными Resource, старые идентификаторы перенаправляются.
	assert(HeroState.START_HEALTH == 40)
	var expected_stats := {
		"rabbit_symbiont": [3, 1], "hunter": [5, 2], "giant_crab": [8, 2],
		"lobar": [12, 3], "kadavr": [15, 4]
	}
	assert(MonsterCatalog.DEFINITIONS.size() == expected_stats.size())
	for monster_kind in expected_stats:
		var definition: MonsterDefinition = MonsterCatalog.get_monster(monster_kind)
		assert(definition.monster_id == monster_kind)
		assert(definition.max_health == int(expected_stats[monster_kind][0]))
		assert(definition.attack_damage == int(expected_stats[monster_kind][1]))
		assert(definition.icon != null)
	assert(MonsterCatalog.get_monster("small_monster").monster_id == "rabbit_symbiont")
	assert(MonsterCatalog.get_monster("skeleton_guard").monster_id == "hunter")
	assert(MonsterCatalog.get_monster("unknown").monster_id == "rabbit_symbiont")
	var monster_map := DungeonMap.create_blank(8, 8)
	assert(monster_map.place_entity("player_spawn", 2, 2))
	assert(monster_map.place_entity("monster", 3, 2))
	var monster_entity: Dictionary = monster_map.entities_at(3, 2)[0]
	var monster_entity_id: String = str(monster_entity["id"])
	assert(MonsterCatalog.from_entity(monster_entity).monster_id == "rabbit_symbiont")
	assert(not monster_map.set_monster_type(monster_entity_id, "unknown"))
	assert(monster_map.set_monster_type(monster_entity_id, "hunter"))
	assert(not monster_map.set_monster_type(monster_entity_id, "hunter"))
	var hunter_json := JSON.stringify(monster_map.to_dict())
	var hunter_loaded := DungeonMap.from_dict(JSON.parse_string(hunter_json))
	assert(hunter_loaded != null)
	var hunter_game := GameSession.start_for(hunter_loaded)
	assert(not hunter_game.move_by(1, 0))
	assert(hunter_game.pending_monster_definition().monster_id == "hunter")
	var hunter_fight := CombatSession.new(hunter_game.pending_monster_definition(), hunter_game.hero)
	for hit_index in range(5):
		assert(hunter_fight.hero_attack(1) == 1)
	assert(hunter_fight.is_victory)
	assert(hunter_game.hero.health == 40 - 4 * 2)
	assert(hunter_game.win_pending_encounter())
	assert(JSON.stringify(hunter_loaded.to_dict()) == hunter_json)
	# Меч сокращает поединок, щит поглощает единицу урона за ответный удар.
	var guarded_hero := HeroState.new()
	guarded_hero.equip_weapon(ItemCatalog.get_item("sword"))
	guarded_hero.equip_shield(ItemCatalog.get_item("shield"))
	var guarded_fight := CombatSession.new(MonsterCatalog.get_monster("hunter"), guarded_hero)
	assert(guarded_fight.hero_attack(guarded_hero.attack) == 2)
	assert(guarded_fight.enemy_health == 3)
	assert(guarded_fight.last_counter_damage == 1 and guarded_fight.last_blocked_damage == 1)
	assert(guarded_hero.health == 39)
	assert(guarded_fight.hero_attack(guarded_hero.attack) == 2)
	assert(guarded_fight.hero_attack(guarded_hero.attack) == 2 and guarded_fight.is_victory)
	assert(guarded_hero.health == 38)
	# Поражение не удаляет монстра из игрового мира.
	var fragile := HeroState.new()
	fragile.health = 1
	var losing_fight := CombatSession.new(MonsterCatalog.get_monster("hunter"), fragile)
	assert(losing_fight.hero_attack(1) == 1)
	assert(losing_fight.is_defeat and not losing_fight.is_victory)
	assert(fragile.health == 0 and losing_fight.hero_attack(1) == 0)
	# Совместимость JSON, в котором стояли прежние монстры.
	monster_entity["properties"] = {"monster_id": "skeleton_guard"}
	assert(MonsterCatalog.from_entity(monster_entity).monster_id == "hunter")
	monster_entity["properties"] = {}
	assert(MonsterCatalog.from_entity(monster_entity).monster_id == "rabbit_symbiont")
	# Награда за победу настраивается у конкретного монстра, исходный JSON неизменен.
	assert(monster_map.set_monster_loot(monster_entity_id, ["gold", "potion", "sword"], 27))
	assert(not monster_map.set_monster_loot(monster_entity_id, ["gold", "potion", "sword"], 27))
	assert(DungeonMap.monster_gold_amount(monster_entity) == 27)
	assert(DungeonMap.monster_loot_contents(monster_entity) == ["gold", "potion", "sword"])
	var reward_json := JSON.stringify(monster_map.to_dict())
	var reward_game := GameSession.start_for(monster_map)
	assert(not reward_game.move_by(1, 0))
	assert(reward_game.win_pending_encounter())
	assert(reward_game.hero.gold == 27)
	assert(reward_game.potions == 1)
	assert(reward_game.hero.equipped_weapon_id == "sword")
	var victory_events := reward_game.take_message_events()
	assert(victory_events.size() == 1 and victory_events[0]["loot"].size() == 3)
	assert(not reward_game.win_pending_encounter())
	assert(JSON.stringify(monster_map.to_dict()) == reward_json)
	var reward_again := GameSession.start_for(monster_map)
	assert(reward_again.hero.gold == 0 and reward_again.potions == 0)
	# Совместимость: старые карты с находками непосредственно на полу продолжают работать.
	assert(gold_map_loaded.entities_at(3, 2).size() == 1)
	# Использование расходников: лечение по свойствам Resource, без перерасхода.
	var healer := HeroState.new()
	assert(healer.restore_health(10) == 0) # Полное здоровье.
	healer.health = 12
	var potion_def: ItemDefinition = ItemCatalog.get_item("potion")
	assert(potion_def.healing_amount > 0)
	var potion_session := GameSession.start_for(tiny_restored)
	assert(potion_session != null)
	potion_session._receive_item("potion", 2)
	potion_session._receive_item("key", 1)
	assert(not bool(potion_session.use_item("key")["used"]))
	assert(potion_session.keys == 1 and potion_session.potions == 2)
	potion_session.hero.health = potion_session.hero.max_health - 2
	assert(bool(potion_session.use_item("potion")["used"]))
	assert(potion_session.hero.health == potion_session.hero.max_health)
	assert(potion_session.potions == 1)
	assert(not bool(potion_session.use_item("potion")["used"]))
	assert(potion_session.potions == 1)
	potion_session.hero.health = 1
	assert(bool(potion_session.use_item("potion")["used"]))
	assert(potion_session.hero.health == 1 + potion_def.healing_amount)
	assert(potion_session.potions == 0)
	assert(not bool(potion_session.use_item("potion")["used"]))
	assert(potion_session.hero.health == 1 + potion_def.healing_amount)
	assert(potion_session.carried_items.get("potion", 0) == 0)

	# Случайная добыча не содержит квестовых предметов.
	for i in range(100):
		var reward: Dictionary = ItemCatalog.roll_loot()
		var reward_item: ItemDefinition = ItemCatalog.get_item(str(reward.get("item_id", "")))
		assert(reward_item != null and reward_item.category != ItemDefinition.Category.QUEST)

	# Двуручное оружие снимает щит, но не уничтожает его.
	var two_handed_hero := HeroState.new()
	var shield_item: ItemDefinition = ItemCatalog.get_item("shield")
	var sword_item: ItemDefinition = ItemCatalog.get_item("sword")
	var heavy_item: ItemDefinition = ItemCatalog.get_item("greatsword")
	assert(heavy_item != null and heavy_item.two_handed)
	assert(two_handed_hero.equip_item(shield_item))
	assert(two_handed_hero.equip_item(heavy_item))
	assert(two_handed_hero.equipped_shield_id.is_empty())
	assert(two_handed_hero.defense == two_handed_hero.base_defense)
	assert(not two_handed_hero.equip_item(shield_item))
	assert(two_handed_hero.unequip_item("greatsword"))
	assert(two_handed_hero.equip_item(shield_item))
	assert(two_handed_hero.equip_item(sword_item))
	assert(two_handed_hero.equipped_shield_id == "shield")

	print("DungeonMap smoke tests: OK")
	quit()
