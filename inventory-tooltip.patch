+	if _item_tooltip != null:
+		_item_tooltip.custom_minimum_size.x = minf(420.0, maxf(260.0, _card.custom_minimum_size.x - 36.0))
 	if _session != null:
 		_refresh_contents()
+	elif _item_tooltip != null and _item_tooltip.visible:
+		_show_tooltip_for_current_selection()
 
 
 func _source_at(point: Vector2) -> Dictionary:
@@ -526,8 +596,7 @@ func close_by_player() -> void:
 
 
