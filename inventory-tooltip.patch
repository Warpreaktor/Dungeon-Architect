+func _show_tooltip_for_current_selection() -> void:
+	if _item_tooltip == null:
+		return
+	var anchor: Rect2 = Rect2()
+	if _selected_index >= 0:
+		var cells: Array[Node] = _bag_grid.get_children()
+		if _selected_index < cells.size():
+			anchor = (cells[_selected_index] as Control).get_global_rect()
+	elif not _selected_equipped_slot.is_empty():
+		var slot: EquipmentSlotControl = _mannequin.slots.get(_selected_equipped_slot) as EquipmentSlotControl
+		if slot != null:
+			anchor = slot.get_global_rect()
+	if anchor.size == Vector2.ZERO:
+		_hide_item_tooltip()
+		return
+	_item_tooltip.show()
+	_item_tooltip.reset_size()
+	var tooltip_size: Vector2 = _item_tooltip.get_combined_minimum_size()
+	var card_rect: Rect2 = _card.get_global_rect()
+	var pos := anchor.position + Vector2(anchor.size.x + 14.0, -4.0)
+	if pos.x + tooltip_size.x > card_rect.end.x - 12.0:
+		pos.x = anchor.position.x - tooltip_size.x - 14.0
+	if pos.x < card_rect.position.x + 12.0:
+		pos.x = card_rect.position.x + 12.0
+	if pos.y + tooltip_size.y > card_rect.end.y - 12.0:
+		pos.y = card_rect.end.y - tooltip_size.y - 12.0
+	if pos.y < card_rect.position.y + 60.0:
+		pos.y = card_rect.position.y + 60.0
+	_item_tooltip.global_position = pos
+
+
+func _hide_item_tooltip() -> void:
+	if _item_tooltip != null:
+		_item_tooltip.hide()
+
 func _show_item(index: int) -> void:
 	if index < 0 or index >= _entries.size() or _session == null:
 		return
