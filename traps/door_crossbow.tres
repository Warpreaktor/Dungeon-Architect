[resource]
script = ExtResource("1_script")
trap_id = "door_crossbow"
display_name = "Самострел"
description = "Скрытый дверной арбалет наносит {direct_damage} HP урона открывающему дверь герою при открытии двери.{after_trigger}"
icon_art = ExtResource("2_icon")
placement = "door"
trigger_visual = "crossbow_shot"
trigger_message = "Стоило тебе открыть дверь, как скрытый арбалет выпустил болт прямо в тебя!"
hidden_by_default = true
detection_difficulty = 9
avoidance_difficulty = 12
disarm_difficulty = 14
avoidance_stat = "agility"
direct_damage = 4
disarm_on_trigger = true
blocks_path = false
