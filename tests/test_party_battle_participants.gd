extends SceneTree


func _initialize() -> void:
	var wolf := HeroState.new(HeroCatalog.get_hero("volcha"))
	var rooster := HeroState.new(HeroCatalog.get_hero("petushan"))
	var shield: ItemDefinition = ItemCatalog.get_item("shield")
	rooster.register_shield(shield)
	assert(rooster.equip_item(shield))
	rooster.learned_ability_ids.append("basic_strike")
	var original_wolf_hp: int = wolf.health
	var original_rooster_hp: int = rooster.health
	var party: Array[HeroState] = [wolf, rooster]
	var monster: MonsterDefinition = MonsterCatalog.get_monster("skeleton")
	var combat := CombatSession.new(monster, wolf, monster, 4274, party)
	var battle: BattleState = combat.battle_state
	assert(battle.hero_ids() == ["hero", "hero_2"])
	assert(battle.enemy_ids() == ["enemy", "enemy_support"])
	assert(battle.get_hero() == battle.get_participant("hero"))
	var fighter_wolf: BattleParticipant = battle.get_participant("hero")
	var fighter_rooster: BattleParticipant = battle.get_participant("hero_2")
	assert(fighter_wolf != fighter_rooster)
	assert(fighter_wolf._hero_snapshot != wolf)
	assert(fighter_rooster._hero_snapshot != rooster)
	assert(fighter_wolf.definition_id == "volcha")
	assert(fighter_rooster.definition_id == "petushan")
	assert(fighter_rooster.equipped_shield_id == "shield")
	assert(fighter_rooster.learned_ability_ids.has("basic_strike"))
	assert(not fighter_wolf.learned_ability_ids.has("basic_strike"))
	var attack: AbilityDefinition = AbilityCatalog.get_ability("basic_strike")
	assert(battle.create_context().target_ids("enemy", attack) == ["hero", "hero_2"])
	assert(battle.create_context().target_ids("hero_2", attack) == ["enemy", "enemy_support"])
	fighter_rooster.receive_damage(3)
	fighter_wolf.receive_damage(2)
	assert(wolf.health == original_wolf_hp and rooster.health == original_rooster_hp)
	fighter_rooster.statuses["test_status"] = {"battle_only": true}
	fighter_rooster.statuses["persistent_status"] = {"battle_only": false}
	assert(not rooster.overworld_statuses.has("persistent_status"))
	combat.sync_hero_results()
	assert(wolf.health == original_wolf_hp - 2)
	assert(rooster.health == original_rooster_hp - 3)
	assert(not rooster.overworld_statuses.has("test_status"))
	assert(rooster.overworld_statuses.has("persistent_status"))
	assert(not wolf.overworld_statuses.has("persistent_status"))
	assert(rooster.current_shield_durability("shield") == fighter_rooster._hero_snapshot.current_shield_durability("shield"))
	fighter_wolf.receive_damage(9999)
	battle.update_outcome()
	assert(not battle.is_defeat)
	assert(battle.living_hero_ids() == ["hero_2"])
	assert(battle.create_context().target_ids("enemy", attack) == ["hero_2"])
	combat.sync_hero_results()
	assert(wolf.health == 0 and rooster.health > 0)
	fighter_rooster.receive_damage(9999)
	battle.update_outcome()
	assert(battle.is_defeat and battle.living_hero_ids().is_empty())
	combat.sync_hero_results()
	assert(rooster.health == 0)
	var solo := CombatSession.new(monster, HeroState.new(HeroCatalog.get_hero("volcha")), null, 4274)
	assert(solo.battle_state.hero_ids() == ["hero"])
	assert(solo.battle_state.get_participant("hero_2") == null)
	quit()
