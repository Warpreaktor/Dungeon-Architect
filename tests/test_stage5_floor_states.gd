extends SceneTree


func _initialize() -> void:
	_test_multiple_floors_and_revisits()
	_test_snapshot_isolation_and_current_floor()
	_test_debug_map_keeps_exploration()
	_test_rejected_transition_leaves_state_unchanged()
	print("Stage 5 floor states: revisits, events, loot, fog and isolation OK")
	quit()


func _new_floor(map_id: String, spawn: Vector2i = Vector2i(2, 2)) -> DungeonMap:
	var dungeon := DungeonMap.create_blank(10, 8)
	dungeon.map_id = map_id
	assert(dungeon.place_entity("player_spawn", spawn.x, spawn.y))
	return dungeon


func _entity(dungeon: DungeonMap, cell: Vector2i, kind: String) -> Dictionary:
	for entity in dungeon.entities_at(cell.x, cell.y):
		if str(entity.get("type", "")) == kind:
			return entity
	return {}


func _test_multiple_floors_and_revisits() -> void:
	var first: DungeonMap = _new_floor("stage5_floor_first")
	var second: DungeonMap = _new_floor("stage5_floor_second")
	var third: DungeonMap = _new_floor("stage5_floor_third", Vector2i(4, 3))
	assert(first.place_entity("trigger", 2, 2))
	assert(first.set_message_at(2, 2, "Первое посещение"))
	assert(first.place_entity("trap", 3, 3, {"trap_id": "spikes"}))
	assert(first.place_entity("chest", 3, 2))
	assert(first.place_entity("door", 4, 2))
	assert(first.place_entity("monster", 5, 2, {"monster_id": "skeleton"}))
	assert(first.place_entity("stairs_down", 6, 2))
	var trap: Dictionary = _entity(first, Vector2i(3, 3), "trap")
	var chest: Dictionary = _entity(first, Vector2i(3, 2), "chest")
	var door: Dictionary = _entity(first, Vector2i(4, 2), "door")
	var monster: Dictionary = _entity(first, Vector2i(5, 2), "monster")
	var stairs: Dictionary = _entity(first, Vector2i(6, 2), "stairs_down")
	assert(first.set_chest_contents(str(chest["id"]), ["key"], 5, false, false, {"key": 2}))
	assert(first.set_chest_contents(str(stairs["id"]), ["gold"], 13, false, false, {"gold": 13}))
	assert(second.place_entity("potion", 2, 2))
	assert(second.place_entity("trigger", 2, 2))
	assert(second.set_message_at(2, 2, "Второй этаж"))
	assert(second.place_entity("trap", 3, 3, {"trap_id": "spikes"}))
	var second_trap: Dictionary = _entity(second, Vector2i(3, 3), "trap")
	second_trap["id"] = str(trap["id"])
	var second_trigger: Dictionary = _entity(second, Vector2i(2, 2), "trigger")
	second_trigger["id"] = str(_entity(first, Vector2i(2, 2), "trigger")["id"])
	var second_message: Dictionary = _entity(second, Vector2i(2, 2), "message")
	second_message["id"] = str(_entity(first, Vector2i(2, 2), "message")["id"])
	assert(second.place_entity("stairs_down", 8, 4))
	var second_stairs: Dictionary = _entity(second, Vector2i(8, 4), "stairs_down")
	second_stairs["id"] = str(stairs["id"])
	var second_pickup: Dictionary = _entity(second, Vector2i(2, 2), "potion")
	var original_first: String = JSON.stringify(first.to_dict())
	var original_second: String = JSON.stringify(second.to_dict())
	var original_third: String = JSON.stringify(third.to_dict())
	var hero_ids: Array[String] = ["petushan", "volcha"]
	var session: GameSession = GameSession.start_for_party(first, hero_ids)
	assert(session != null)
	var members: Array[HeroState] = session.party_members()
	var initial_steps: int = session.steps
	assert(session.take_trigger_events().size() == 1)
	assert(session.take_message_events().size() == 1)
	assert(session.floor_state_snapshot()["position"] == Vector2i(2, 2))
	assert(session.floor_state_snapshot()["messages"].size() == 1)
	assert(session.visited_floor_snapshots().size() == 1)
	var first_loot: Array[Dictionary] = [{"item_id": "gold", "quantity": 17}]
	session._append_ground_loot(Vector2i(2, 4), first_loot)
	var first_container_id: String = str(session.ground_container_at(Vector2i(2, 4))["id"])

	assert(session.move_by(0, 1))
	assert(not session.move_by(1, 0))
	assert(session.last_move_detected_trap)
	assert(not session.move_by(1, 0))
	assert(session.resolve_pending_trap_choice("avoid"))
	assert(session.is_trap_disarmed(trap))
	assert(session.is_trap_revealed(trap))
	assert(session.move_by(0, -1))
	assert(session.is_chest_open(chest))
	assert(int(session.carried_items.get("key", 0)) == 2)
	assert(session.move_by(1, 0))
	assert(session.is_entity_removed(door))
	assert(int(session.carried_items.get("key", 0)) == 1)
	assert(not session.move_by(1, 0))
	assert(session.has_pending_encounter())
	assert(session.win_pending_encounter())
	assert(session.is_entity_removed(monster))
	assert(session.move_by(1, 0))
	assert(session.is_completed)
	assert(session.claimed_exit_rewards.has(str(stairs["id"])))
	var exit_gold: int = members[0].gold
	var inventory_before: Dictionary = session.carried_items.duplicate(true)
	var steps_before: int = session.steps
	assert(steps_before > initial_steps)
	assert(not session.is_revealed(8, 6))
	assert(session.floor_state_snapshot()["position"] == Vector2i(6, 2))

	assert(session.enter_map(second))
	assert(session.player_pos == Vector2i(2, 2))
	assert(session.take_trigger_events().size() == 1)
	assert(session.take_message_events().size() == 1)
	assert(session.is_entity_removed(second_pickup))
	assert(not session.is_trap_disarmed(second_trap))
	assert(not session.claimed_exit_rewards.has(str(stairs["id"])))
	assert(int(session.carried_items.get("potion", 0)) == int(inventory_before.get("potion", 0)) + 1)
	assert(not session.is_entity_removed(door))
	assert(not session.is_chest_open(chest))
	assert(not session.is_trap_disarmed(trap))
	assert(session.visited_floor_snapshots().size() == 2)
	assert(session.floor_state_snapshot(first.map_id)["position"] == Vector2i(6, 2))
	assert(session.floor_state_snapshot(first.map_id)["exit_rewards"].has(str(stairs["id"])))

	var loot: Array[Dictionary] = [{"item_id": "gold", "quantity": 21}]
	session._append_ground_loot(Vector2i(3, 2), loot)
	var second_container: Dictionary = session.ground_container_at(Vector2i(3, 2))
	var container_id: String = str(second_container["id"])
	assert(not container_id.is_empty())
	assert(container_id != first_container_id)
	assert(session.move_by(1, 0))
	assert(session.floor_state_snapshot()["position"] == Vector2i(3, 2))
	assert(session.enter_map(third))
	assert(session.player_pos == Vector2i(4, 3))
	assert(session.visited_floor_snapshots().size() == 3)
	assert(session.enter_map(first))
	assert(session.player_pos == Vector2i(2, 2))
	assert(session.map_data == first)
	assert(session.is_entity_removed(door))
	assert(session.is_entity_removed(monster))
	assert(session.is_chest_open(chest))
	assert(session.is_trap_disarmed(trap))
	assert(session.is_trap_revealed(trap))
	assert(session.claimed_exit_rewards.has(str(stairs["id"])))
	assert(session.ground_container_by_id(first_container_id)["loot"][0]["quantity"] == 17)
	assert(session.ground_container_by_id(container_id).is_empty())
	assert(session.take_trigger_events().is_empty())
	assert(session.take_message_events().is_empty())
	assert(session.is_revealed(6, 2))
	assert(not session.is_revealed(8, 6))
	assert(session.steps == steps_before + 1)
	assert(session.hero == members[0])
	assert(session.party_members() == members)
	assert(session.carried_items.get("key", 0) == inventory_before.get("key", 0))
	assert(members[0].gold == exit_gold)
	assert(session.move_by(1, 0))
	assert(session.move_by(1, 0))
	assert(session.move_by(1, 0))
	assert(session.move_by(1, 0))
	assert(not session.has_pending_encounter())
	assert(int(session.carried_items.get("key", 0)) == int(inventory_before.get("key", 0)))
	assert(members[0].gold == exit_gold)
	assert(session.enter_map(second))
	assert(session.player_pos == Vector2i(2, 2))
	assert(session.ground_container_by_id(container_id)["loot"][0]["quantity"] == 21)
	assert(session.is_entity_removed(second_pickup))
	assert(session.take_message_events().is_empty())
	assert(session.take_trigger_events().is_empty())
	var potions_before: int = int(session.carried_items.get("potion", 0))
	assert(session.enter_map(third))
	assert(session.enter_map(second))
	assert(int(session.carried_items.get("potion", 0)) == potions_before)
	assert(session.take_ground_loot(container_id, 0) == 21)
	assert(session.ground_container_by_id(container_id).is_empty())
	assert(session.enter_map(first))
	assert(session.enter_map(second))
	assert(session.ground_container_by_id(container_id).is_empty())
	assert(session.visited_floor_snapshots().size() == 3)
	assert(JSON.stringify(first.to_dict()) == original_first)
	assert(JSON.stringify(second.to_dict()) == original_second)
	assert(JSON.stringify(third.to_dict()) == original_third)


func _test_snapshot_isolation_and_current_floor() -> void:
	var first: DungeonMap = _new_floor("stage5_snap_first")
	var second: DungeonMap = _new_floor("stage5_snap_second")
	var session: GameSession = GameSession.start_for(first)
	var entries: Array[Dictionary] = [{"item_id": "gold", "quantity": 8}]
	session._append_ground_loot(Vector2i(3, 2), entries)
	var original: Dictionary = session.floor_state_snapshot()
	var id: String = str(session.ground_loot_containers[0]["id"])
	assert(original["ground_loot"].size() == 1)
	assert(original["map_id"] == first.map_id)
	assert(not original.has("map"))
	assert(session.floor_state_snapshot("unknown_floor").is_empty())
	original["ground_loot"][0]["loot"][0]["quantity"] = 800
	original["removed"]["irrelevant"] = true
	original["revealed"][2][2] = false
	assert(session.ground_container_by_id(id)["loot"][0]["quantity"] == 8)
	assert(not session.removed_entities.has("irrelevant"))
	assert(session.is_revealed(2, 2))
	assert(session.enter_map(second))
	var left: Dictionary = session.floor_state_snapshot(first.map_id)
	assert(left["ground_loot"][0]["loot"][0]["quantity"] == 8)
	left["ground_loot"][0]["loot"].clear()
	left["messages"]["ignored"] = true
	assert(session.enter_map(first))
	assert(session.ground_container_by_id(id)["loot"][0]["quantity"] == 8)
	assert(not session.shown_messages.has("ignored"))
	assert(session.enter_map(first))
	assert(session.ground_container_by_id(id)["loot"][0]["quantity"] == 8)
	assert(session.visited_floor_snapshots().size() == 2)


func _test_debug_map_keeps_exploration() -> void:
	var first: DungeonMap = _new_floor("stage5_debug_first")
	var second: DungeonMap = _new_floor("stage5_debug_second")
	var session: GameSession = GameSession.start_for(first, "petushan", true)
	assert(session.is_revealed(7, 5))
	assert(not session.floor_state_snapshot()["revealed"][5][7])
	assert(session.move_by(1, 0))
	assert(session.floor_state_snapshot()["revealed"][2][4])
	assert(session.enter_map(second))
	assert(not session.floor_state_snapshot(first.map_id)["revealed"][5][7])
	assert(session.is_revealed(7, 5))
	assert(session.enter_map(first))
	assert(session.is_revealed(7, 5))
	session.set_debug_open_map(false)
	assert(not session.is_revealed(7, 5))
	assert(session.is_revealed(4, 2))
	assert(session.is_revealed(2, 2))
	assert(session.enter_map(second))
	assert(not session.is_revealed(7, 5))
	assert(session.enter_map(first))
	assert(not session.is_revealed(7, 5))


func _test_rejected_transition_leaves_state_unchanged() -> void:
	var first: DungeonMap = _new_floor("stage5_invalid_first")
	var bad: DungeonMap = _new_floor("stage5_invalid_second")
	assert(bad.place_entity("door", 2, 2))
	var session: GameSession = GameSession.start_for(first)
	var before: Dictionary = session.floor_state_snapshot()
	assert(not session.enter_map(bad))
	assert(session.map_data == first)
	assert(session.player_pos == Vector2i(2, 2))
	assert(session.floor_state_snapshot() == before)
	assert(session._floor_states.is_empty())
	assert(session.visited_floor_snapshots().size() == 1)
